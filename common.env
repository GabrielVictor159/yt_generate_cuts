ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=monitoring;Username=postgres;Password=123
DownloadPath=/app/downloads

# Teto de videos por etapa, aplicado por canal monitorado. 0 ou ausente = sem limite.
# Failed nunca ocupa vaga.
VideoStageLimits__Created=5
VideoStageLimits__Download=5
# Process e Removed sao etapas finais e nada as esvazia sozinho: um teto nelas
# interromperia a entrada de videos novos em definitivo. Deixe sem limite.
# VideoStageLimits__Process=0
# VideoStageLimits__Removed=0

# Tempo de vida do lock distribuido que garante uma execucao por canal.
Hangfire__DistributedLockTimeoutMinutes=60

# Recuperacao depois de um encerramento abrupto (Stop do Visual Studio, kill do
# container). Com a invisibilidade deslizante ligada no codigo, este prazo
# significa "quanto tempo depois de o worker morrer o job volta para a fila".
# O padrao do Hangfire sao 30 minutos, e era isso que fazia o sistema parecer
# travado depois de parar a execucao.
Hangfire__InvisibilityTimeoutMinutes=5

# Quanto o watchdog espera para considerar um servidor morto e devolver os jobs.
Hangfire__ServerTimeoutMinutes=2

# Workers por servidor. As etapas serias ja se excluem por lock; este numero
# afeta quantos jobs distintos podem correr juntos na mesma fila.
Hangfire__WorkerCount=10

# Cookies de uma sessao logada do YouTube, formato Netscape (cookies.txt).
# Sem isto o cliente e anonimo. Monte o arquivo no container antes de usar:
#   volumes: - ./cookies/youtube.txt:/app/cookies/youtube.txt:ro
# YouTube__CookiesFile=/app/cookies/youtube.txt

# Provedores de video. O catalogo (listagem) fica no YoutubeExplode, que roda
# em processo e e rapido. O download vai para o yt-dlp, que e o mantido contra
# as mudancas do endpoint de player do YouTube, com o YoutubeExplode de reserva.
# A lista do Downloader e ordenada e forma a cadeia de fallback.
VideoSource__Catalog=youtubeexplode
VideoSource__Downloader=ytdlp,youtubeexplode
VideoSource__MaxUploadsPerCycle=50

# yt-dlp
YtDlp__ExecutablePath=/usr/local/bin/yt-dlp
# ATENCAO: aqui vai um CAMINHO, nao o nome do executavel. O valor anterior era
# "ffmpeg", e o yt-dlp responde a isso com
#   WARNING: ffmpeg-location ffmpeg does not exist! Continuing without ffmpeg
# baixando os dois fluxos, NAO conseguindo juntá-los e terminando com codigo
# zero, deixando so os intermediarios .f398.mp4 e .f251.webm. Era isso que
# quebrava todo download.
# Vazio (o recomendado) = o yt-dlp procura no PATH, onde o ffmpeg esta instalado
# no container.
YtDlp__FfmpegPath=

# Seletor de formato. Vazio usa o padrao do codigo, que pede mp4+m4a primeiro
# (H.264 + AAC) para o merge ser uma remuxagem trivial; o padrao do yt-dlp
# tenderia a AV1 + Opus, que e o par que mais falha ao entrar num mp4.
# {height} e substituido pela resolucao maxima pedida.
# YtDlp__FormatSelector=
YtDlp__Retries=3
YtDlp__SocketTimeoutSeconds=30
YtDlp__ProcessTimeoutMinutes=30
# Teto so da etapa de legenda. Menor de proposito: legenda e acessorio e nao
# deve poder segurar o worker o mesmo tempo que um download de 1080p.
YtDlp__SubtitleTimeoutMinutes=5

# Ritmo das requisicoes. E o que evita o HTTP 429: espalhar as chamadas custa
# alguns segundos por video e poupa o ciclo inteiro do canal. Aumente estes dois
# se o 429 voltar a aparecer no log.
YtDlp__SleepRequestsSeconds=1
YtDlp__SleepSubtitlesSeconds=2

# Escape imediato: com false o video e baixado e NENHUMA requisicao de legenda
# e feita. O fluxo segue, mas a etapa de InterestingTimes fica sem insumo.
YtDlp__DownloadSubtitles=true

# Clientes do extrator. Vazio = padrao do yt-dlp (recomendado). Mexer aqui
# so faz sentido para contornar um bloqueio especifico.
# YtDlp__PlayerClients=android,web

# Idiomas de legenda, em ordem de preferencia. Basta o idioma: "pt" ja alcanca
# pt-BR, pt-PT e pt-orig. UMA faixa e baixada por video, escolhida no codigo
# (SubtitleTrackSelector), nao por regex do yt-dlp — era o padrao "pt.*,en.*"
# que baixava todas as variantes de uma vez e provocava o HTTP 429.
Subtitles__PreferredLanguages=pt,en

# Teto de cortes publicados por rodada. Fica aqui, e nao no resources.env, porque
# o worker de publicacao carrega apenas o common.env (ver docker-compose.override).
# A publicacao e serial e global: uma por vez, para nao esbarrar no limite de
# requisicoes das plataformas nem publicar o mesmo corte duas vezes.
Publish__MaxCutsPerCycle=10
