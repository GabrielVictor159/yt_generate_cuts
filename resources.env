# Ollama roda no host Windows (fora do Docker).
# Requer OLLAMA_HOST=0.0.0.0 no host para aceitar conexoes dos containers.
OllamaUrl=http://host.docker.internal:11434

# Confirme o tag exato com 'ollama list' antes de subir.
OLLAMA_MODEL=qwen3:27b

# Contexto por requisicao. Com o janelamento abaixo, cada chamada manda ~12 min
# de legenda (~4 mil tokens), entao 16k sobra. Valor alto aqui so inflaria o
# cache KV na GPU sem beneficio.
NumTokens=16384

# Parametros de amostragem. Extracao pede saida estavel, nao criatividade.
Ollama__Temperature=0.2
Ollama__TopP=0.9
Ollama__Seed=42
Ollama__NumPredict=1024

# Thinking desligado nesta etapa: o bloco de raciocinio atrapalha a saida
# estruturada e custa latencia sem ganho em extracao. O lugar de deliberar
# seria uma etapa posterior de ranqueamento.
Ollama__Think=false

# Janelamento da legenda.
InterestingTimes__WindowMinutes=12
InterestingTimes__OverlapSeconds=60
InterestingTimes__MaxCutsPerWindow=3
InterestingTimes__MaxCutsPerVideo=10

# Quantos videos uma rodada pode analisar. O ciclo e serial por construcao (uma
# inferencia por vez, global), entao este teto so serve para a rodada ter fim
# previsivel; o que sobrar e retomado na rodada seguinte.
InterestingTimes__MaxVideosPerCycle=25

# Teto por rodada da geracao de cortes. Mesma ideia: o ciclo e serial por
# construcao, o teto so garante rodada com fim previsivel.
ProcessCuts__MaxCutsPerCycle=25

# Teto de cortes NAO PUBLICADOS por canal monitorado. Cada canal pode
# sobrescrever pelo campo MaxPendingCuts. Zero = sem limite.
#
# Este freio existe porque a publicacao e o unico ponto do fluxo que consome
# cortes, e ela so age em cortes com canal de publicacao definido. Sem canal
# definido os cortes ficam parados em Process para sempre, enquanto o
# monitoramento segue baixando videos e gerando cortes novos (os videos avancam
# ate Removed e liberam as vagas do teto por etapa). Sem este teto, isso cresce
# indefinidamente em banco e em disco.
Cuts__MaxPendingPerChannel=20

# Geracao do arquivo do corte. O padrao reencoda porque com copia de fluxo o
# corte so pode comecar e terminar em quadro-chave: medido com ffmpeg, 10
# segundos pedidos sairam com 30. Para cortes de 15 a 60 segundos esse desvio e
# o conteudo inteiro. StreamCopy=true troca precisao por velocidade.
Cuts__StreamCopy=false
Cuts__Preset=veryfast
Cuts__Crf=23

# --------------------------------------------------------------------------
# Edicao dos cortes (worker de edicao)
# --------------------------------------------------------------------------
# Padrao global, usado por canais sem perfil de edicao cadastrado. Um perfil no
# canal (tabela EditionConfigurations) sobrescreve tudo abaixo.
Edition__Enabled=true
Edition__Width=1080
Edition__Height=1920
Edition__BurnSubtitles=true
Edition__Preset=veryfast
Edition__Crf=23

# O arquivo pre-edicao e apagado depois de editar com sucesso: manter os dois
# dobraria o disco por corte. true guarda o original para reeditar.
Edition__KeepOriginal=false

# Teto de cortes por rodada. O ciclo e serial (uma edicao por vez, global).
Edition__MaxCutsPerCycle=25

# Duracao do corte: padrao global. Cada canal monitorado pode sobrescrever
# pelos campos MinCutSeconds / MaxCutSeconds.
CutDuration__MinSeconds=15
CutDuration__MaxSeconds=60
